"""Tests for ProgressMonitor.

Run with:
    cd mind/
    python -m pytest tests/test_monitor.py -v
"""

import pytest

from agent_mind.introspection.monitor import (
    ActionResult, MonitorConfig, ActionRecord, ProgressMonitor,
)
from agent_mind.introspection.triggers import TriggerType


class TestActionResult:

    def test_values(self):
        assert ActionResult.PROGRESS.value == "progress"
        assert ActionResult.NO_CHANGE.value == "no_change"
        assert ActionResult.FAILURE.value == "failure"


class TestMonitorConfig:

    def test_defaults(self):
        cfg = MonitorConfig()
        assert cfg.consecutive_failures_threshold == 3
        assert cfg.no_progress_threshold == 5
        assert cfg.min_actions_between_reflections == 3
        assert cfg.max_failures_before_forced_reflect == 10
        assert cfg.max_history == 100

    def test_custom_values(self):
        cfg = MonitorConfig(
            consecutive_failures_threshold=5,
            no_progress_threshold=10,
            min_actions_between_reflections=2,
            max_failures_before_forced_reflect=20,
            max_history=50,
        )
        assert cfg.consecutive_failures_threshold == 5
        assert cfg.max_history == 50


class TestActionRecord:

    def test_creation(self):
        r = ActionRecord(
            action="run tests", result="3 failures",
            classification=ActionResult.FAILURE,
        )
        assert r.action == "run tests"
        assert r.result == "3 failures"
        assert r.classification == ActionResult.FAILURE

    def test_timestamp_auto_set(self):
        r = ActionRecord(
            action="x", result="y", classification=ActionResult.PROGRESS,
        )
        assert r.timestamp is not None

    def test_to_dict(self):
        r = ActionRecord(
            action="check", result="ok", classification=ActionResult.PROGRESS,
        )
        d = r.to_dict()
        assert d["action"] == "check"
        assert d["classification"] == "progress"
        assert "timestamp" in d


